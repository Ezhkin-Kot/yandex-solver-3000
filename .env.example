# "zen" or "firefox". Defaults to "zen".
# BROWSER=zen

# Overrides the browser binary's default location
# (macOS: fixed app-bundle path; Linux: bare command name resolved via $PATH).
# BROWSER_BINARY_PATH=/Applications/Zen.app/Contents/MacOS/zen

# Overrides the dedicated profile directory (default: ~/.zen-bot-profile or
# ~/.firefox-bot-profile, depending on BROWSER).
# BROWSER_PROFILE_DIR=/$HOME/.zen-bot-profile

# Port geckodriver listens on. Defaults to 4445.
# GECKODRIVER_PORT=4445

# 1/true/yes to auto-answer quizzes by picking a random option instead of
# pausing for you to answer manually. Off by default.
# YOLO_MODE=true

# 1/true/yes to auto-solve practical (trainer) tasks: writes a solution into
# the code editor, checks it, and retries with the error on failure. Off by
# default. Submits AI-generated code as your answer. Uses a free local
# model through Ollama (auto-started if not already running — see README).
# AI_SOLVE_MODE=true

# Model used to generate solutions (must already be pulled:
# `ollama pull qwen2.5-coder:3b`). Defaults to qwen2.5-coder:3b.
# OLLAMA_MODEL=qwen2.5-coder:3b

# Max fix attempts per practical task before giving up and leaving it for
# you to solve manually. Defaults to 5.
# MAX_SOLVE_ATTEMPTS=5
